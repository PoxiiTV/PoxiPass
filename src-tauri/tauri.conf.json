{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoxiPass",
  "version": "0.3.1",
  "identifier": "com.poxi.poxipass",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run vite",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PoxiPass",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": false,
        "dragDropEnabled": true,
        "backgroundColor": "#0a0e17",
        "create": false
      },
      {
        "label": "quick",
        "title": "PoxiPass",
        "url": "index.html#quick",
        "width": 680,
        "height": 460,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Poxi",
    "copyright": "Poxi",
    "category": "Utility",
    "shortDescription": "Gestor y generador de contraseñas",
    "longDescription": "PoxiPass guarda tus contraseñas cifradas en tu PC, las genera, te avisa de las débiles o filtradas y las escribe por ti.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../CHANGELOG.md": "CHANGELOG.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCQjNDQTU3NDY3MjlDREYKUldUZm5ISkdWOHF6Nnh1aHREU2s1RHZtQVdCZzMwTE5GSUhFMTZwRkRubHdtcGZ1V3kyUXdKNS8K",
      "endpoints": [
        "https://github.com/PoxiiTV/PoxiPass/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
