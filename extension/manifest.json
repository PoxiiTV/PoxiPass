{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "default_locale": "es",
  "version": "0.0.0",
  "key": "",
  "minimum_chrome_version": "121",
  "icons": { "32": "icons/32.png", "64": "icons/64.png", "128": "icons/128.png" },
  "action": {
    "default_title": "PoxiPass",
    "default_popup": "popup.html",
    "default_icon": { "32": "icons/32.png", "64": "icons/64.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["nativeMessaging", "storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{ "resources": ["nunito.woff2"], "matches": ["http://*/*", "https://*/*"], "use_dynamic_url": true }],
  "commands": {
    "fill-login": {
      "suggested_key": { "default": "Ctrl+Shift+L" },
      "description": "__MSG_cmdFill__"
    }
  }
}
